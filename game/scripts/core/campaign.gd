class_name Campaign
extends RefCounted
## Campaign — the world/level list from res://levels/campaign/index.json (generated by
## levels/campaign/make_campaign.py) and the unlock rule.
##
## Unlock rule: level 1 is open; level N+1 opens when level N is solved. Worlds 1 and 2 are
## free; world 3+ needs the single paid unlock (M7) — until then everything is open so the
## campaign can be play-tested end to end.

const INDEX_PATH := "res://levels/campaign/index.json"
const DIR := "res://levels/campaign/"

static var _index: Dictionary = {}


static func index() -> Dictionary:
	if _index.is_empty():
		var f := FileAccess.open(INDEX_PATH, FileAccess.READ)
		if f:
			var j := JSON.new()
			if j.parse(f.get_as_text()) == OK and j.data is Dictionary:
				_index = j.data
	return _index


static func worlds() -> Array:
	return index().get("worlds", [])


static func level_count() -> int:
	var n := 0
	for w in worlds():
		n += w["levels"].size()
	return n


## Entry {number,id,title,file} for level `number`, or {} if missing.
static func entry(number: int) -> Dictionary:
	for w in worlds():
		for l in w["levels"]:
			if int(l["number"]) == number:
				return l
	return {}


static func path_for(number: int) -> String:
	var e := entry(number)
	return DIR + str(e["file"]) if not e.is_empty() else ""


static func load_level(number: int) -> LevelData:
	var p := path_for(number)
	return LevelData.load_from_file(p) if p != "" else null


static func is_unlocked(number: int, save: SaveData) -> bool:
	if number <= 1:
		return true
	return save.is_solved(number - 1)


static func world_of(number: int) -> int:
	for w in worlds():
		for l in w["levels"]:
			if int(l["number"]) == number:
				return int(w["number"])
	return 0
